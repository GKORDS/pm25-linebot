# คัดลอกไฟล์นี้เป็นชื่อ ".env" แล้วใส่ค่าจริงของคุณลงไป
# (ห้ามนำไฟล์ .env จริงขึ้น GitHub — มันถูกใส่ใน .gitignore ไว้แล้ว)

# --- จาก LINE Developers > ช่อง Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=ใส่_Channel_access_token_ที่นี่
LINE_CHANNEL_SECRET=ใส่_Channel_secret_ที่นี่

# --- สถานีตรวจวัดเริ่มต้น (ดูรหัสได้ในไฟล์ stations.py หรือพิมพ์ "พื้นที่" ในแชต) ---
# 50t = โรงพยาบาลจุฬาลงกรณ์ (ปทุมวัน) กรุงเทพฯ — ดูรหัสอื่นได้ในไฟล์ stations.py
DEFAULT_STATION=50t

# --- การแจ้งเตือนอัตโนมัติ ---
ALERT_ENABLED=true
CHECK_INTERVAL_MINUTES=60
ALERT_COOLDOWN_HOURS=3

# --- โทเค็นลับสำหรับเรียก /check จากภายนอก ---
# ถ้าเว้นว่าง: /check จะเรียกได้จากเครื่องเดียวกัน (localhost) เท่านั้น
# เมื่อนำขึ้นเซิร์ฟเวอร์สาธารณะและต้องการสั่งตรวจจากภายนอก ให้ตั้งค่าลับไว้ด้วย
CHECK_TOKEN=

# --- ไฟล์เก็บข้อมูลผู้ใช้ ---
DATA_FILE=users.json
